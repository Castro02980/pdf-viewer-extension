{
  "manifest_version": 3,
  "name": "PDF Viewer",
  "version": "1.0.0",
  "description": "Simple offline PDF viewer for Chrome",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}